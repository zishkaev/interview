  m_text: "\u0414\u043B\u044F \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0439
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441\u043F\u0438\u0441\u043E\u043A \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0445
    \u0432\u0430\u043A\u0430\u043D\u0441\u0438\u0439. \u041A\u0430\u0436\u0434\u0430\u044F
    \u0432\u0430\u043A\u0430\u043D\u0441\u0438\u044F \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u0435\u0442\u0441\u044F
    \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0435\u0439
    \u043F\u043E \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044E. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435
    \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E,
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442
    \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0439 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F."

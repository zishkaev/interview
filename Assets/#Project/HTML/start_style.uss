/* ====== Переменные (в USS их нет, поэтому используем конкретные значения) ======
   --color-primary:      rgb(35,62,118)
   --color-accent:       rgb(1,152,175)
   --color-secondary:    rgb(39,94,159)
   --color-bg-main:      rgb(255,255,255)
   --color-bg-secondary: rgb(243,243,243)
   --color-bg-dark:      rgb(25,61,87)
   --color-text-primary: rgb(2,2,2)
   --color-text-secondary: rgb(145,151,163)
*/

/* ====== Базовые контейнеры ====== */

.html-tag-body {
    background-color: rgb(255,255,255);
    color: rgb(2,2,2);
    flex-direction: column;
    flex-grow: 1;
    min-height: 1080px;
}

.header {
    background-color: rgb(255,255,255);
    border-bottom-width: 1px;
    border-bottom-color: rgb(234,236,239);
    padding-top: 16px;
    padding-bottom: 16px;
    flex-direction: column;
}

.header-inner {
    max-width: 1360px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 32px;
    padding-right: 32px;
    align-items: center;
    justify-content: space-between;
    flex-direction: row;
}

.logo {
    align-items: center;
    color: rgb(35,62,118);
    font-size: 18px;
    -unity-font-style: bold;
    flex-direction: row;
}

.logo-mark {
    width: 40px;
    height: 40px;
    background-color: rgb(35,62,118);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    color: rgb(255,255,255);
    flex-shrink: 0;
    -unity-font-style: bold;
}

.logo-text .html-tag-small {
    font-size: 11px;
    color: rgb(145,151,163);
}

.header-nav {
    align-items: center;
    flex-direction: row;
}

.header-nav .html-tag-a {
    color: rgb(2,2,2);
}

.header-nav .html-tag-a:hover {
    color: rgb(1,152,175);
}

/* ====== Прогресс-бар ====== */

.progress-bar {
    background-color: rgb(243,243,243);
    padding-top: 12px;
    padding-bottom: 12px;
    flex-direction: column;
}

.progress-inner {
    max-width: 1360px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 32px;
    padding-right: 32px;
    align-items: center;
    flex-direction: row;
}

.progress-step {
    height: 6px;
    background-color: rgb(224,228,236);
    border-radius: 3px;
    transition-property: background-color;
    transition-duration: 0.3s;
}

.progress-label {
    font-size: 13px;
    color: rgb(145,151,163);
    white-space: nowrap;
}

/* ====== Main ====== */

.main {
    max-width: 1360px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-top: 64px;
    padding-left: 32px;
    padding-right: 32px;
    padding-bottom: 80px;
    flex-direction: column;
    flex-grow: 1;
}

/* ====== Экраны ====== */

.screen {
    display: none;
    flex-direction: column;
}

.screen.active {
    display: flex;
}

/* ====== Хлебные крошки и заголовки ====== */

.breadcrumbs {
    font-size: 13px;
    color: rgb(145,151,163);
    margin-bottom: 64px;
    flex-direction: row;
    flex-wrap: wrap;
}

.breadcrumbs .html-tag-a {
    color: rgb(1,152,175);
}

.html-tag-h1 {
    font-size: 42px;
    color: rgb(35,62,118);
    margin-bottom: 56px;
    -unity-font-style: bold;
    white-space: normal;
}

.html-tag-h2 {
    font-size: 28px;
    color: rgb(35,62,118);
    margin-top: 80px;
    margin-bottom: 32px;
    -unity-font-style: bold;
    white-space: normal;
}

.html-tag-h3 {
    font-size: 18px;
    color: rgb(35,62,118);
    -unity-font-style: bold;
    white-space: normal;
}

.html-tag-h4 {
    font-size: 16px;
    color: rgb(35,62,118);
    -unity-font-style: bold;
    white-space: normal;
}

.html-tag-p {
    font-size: 16px;
    margin-bottom: 24px;
    max-width: 720px;
    white-space: normal;
}

.html-tag-span {
    font-size: 13px;
    color: rgb(145,151,163);
    white-space: normal;
}

.html-tag-a {
    color: rgb(1,152,175);
}

/* ====== Welcome hero ====== */

.welcome-hero {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 80px;
}

.welcome-text {
    flex-grow: 1;
    flex-direction: column;
    margin: 32px;
}

.welcome-text .html-tag-h1 {
    margin-bottom: 32px;
}

.welcome-text .subtitle {
    font-size: 18px;
    color: rgb(145,151,163);
    margin-bottom: 40px;
}

.welcome-visual {
    border-radius: 24px;
    padding: 48px;
    color: rgb(255,255,255);
    min-height: 420px;
    justify-content: space-between;
    overflow: hidden;
    background-color: rgb(1,152,175);
    flex-grow: 1;
    flex-direction: column;
    margin: 32px;
}

.mascot {
    font-size: 120px;
    -unity-text-align: middle-center;
}

.welcome-visual .quote {
    font-size: 20px;
    -unity-font-style: italic;
    white-space: normal;
}

/* ====== Features ====== */

.features {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 80px;
}

.feature-card {
    background-color: rgb(243,243,243);
    border-radius: 16px;
    padding: 32px;
    transition-property: translate, box-shadow;
    transition-duration: 0.2s;
    flex-grow: 1;
    flex-direction: column;
    margin: 16px;
    flex-basis: 260px;
}

.feature-card:hover {
    translate: 0 -4px;
}

.feature-icon {
    width: 56px;
    height: 56px;
    background-color: rgb(1,152,175);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    color: rgb(255,255,255);
    font-size: 24px;
    margin-bottom: 20px;
    flex-direction: row;
    -unity-text-align: middle-center;
}

.feature-card .html-tag-h3 {
    font-size: 18px;
    color: rgb(35,62,118);
    margin-bottom: 12px;
    -unity-font-style: bold;
}

.feature-card .html-tag-p {
    color: rgb(145,151,163);
}

/* ====== Кнопки ====== */

.btn {
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    border-radius: 8px;
    font-size: 16px;
    transition-property: background-color, translate, color, border-color;
    transition-duration: 0.2s;
    -unity-text-align: middle-center;
    flex-direction: row;
}

.btn-primary {
    background-color: rgb(35,62,118);
    color: rgb(255,255,255);
}

.btn-primary:hover {
    background-color: rgb(39,94,159);
    translate: 0 -2px;
}

.btn-secondary {
    background-color: rgba(0,0,0,0);
    color: rgb(35,62,118);
    border-width: 2px;
    border-color: rgb(35,62,118);
}

.btn-secondary:hover {
    background-color: rgb(35,62,118);
    color: rgb(255,255,255);
}

.btn-accent {
    background-color: rgb(1,152,175);
    color: rgb(255,255,255);
}

.btn-accent:hover {
    background-color: rgb(1,122,141);
    translate: 0 -2px;
}

.btn-lg {
    padding: 20px 40px;
    font-size: 18px;
}

/* ====== Сетки выбора ====== */

.selection-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 40px;
}

.selection-card {
    background-color: rgb(255,255,255);
    border-width: 2px;
    border-color: rgb(224,228,236);
    border-radius: 16px;
    padding: 32px;
    transition-property: border-color, translate;
    transition-duration: 0.2s;
    flex-grow: 1;
    flex-basis: 280px;
    flex-direction: column;
    margin: 12px;
}

.selection-card:hover {
    border-color: rgb(1,152,175);
    translate: 0 -4px;
}

.card-icon {
    width: 64px;
    height: 64px;
    background-color: rgb(243,243,243);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    margin-bottom: 20px;
    flex-direction: row;
    -unity-text-align: middle-center;
}

.selection-card .html-tag-h3 {
    font-size: 20px;
    color: rgb(35,62,118);
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.selection-card .html-tag-p {
    color: rgb(145,151,163);
}

.card-tag {
    background-color: rgb(1,152,175);
    color: rgb(255,255,255);
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    margin-top: 12px;
    align-self: flex-start;
}

/* ====== Карточки вакансий ====== */

.vacancy-card {
    background-color: rgb(255,255,255);
    border-width: 2px;
    border-color: rgb(224,228,236);
    border-radius: 16px;
    padding: 28px;
    transition-property: border-color;
    transition-duration: 0.2s;
    align-items: flex-start;
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 400px;
    margin: 12px;
}

.vacancy-card:hover {
    border-color: rgb(1,152,175);
}

.vacancy-logo {
    width: 64px;
    height: 64px;
    background-color: rgb(243,243,243);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
    flex-direction: row;
    -unity-text-align: middle-center;
}

.vacancy-info {
    flex-grow: 1;
    flex-direction: column;
    margin-left: 16px;
}

.vacancy-info .html-tag-h3 {
    font-size: 18px;
    color: rgb(35,62,118);
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.vacancy-meta {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}

.vacancy-meta .html-tag-span {
    font-size: 13px;
    color: rgb(145,151,163);
    margin-right: 16px;
}

.rec-badge {
    background-color: rgb(232,244,248);
    color: rgb(1,152,175);
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12px;
    margin-top: 12px;
    align-self: flex-start;
    white-space: normal;
}

/* ====== Чат ====== */

.chat-container {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    background-color: rgb(255,255,255);
    border-radius: 20px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgb(224,228,236);
    flex-direction: column;
    width: 100%;
}

.chat-header {
    background-color: rgb(35,62,118);
    color: rgb(255,255,255);
    padding: 20px 28px;
    align-items: center;
    flex-direction: row;
}

.chat-avatar {
    width: 48px;
    height: 48px;
    background-color: rgb(1,152,175);
    border-radius: 24px;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    flex-direction: row;
    -unity-text-align: middle-center;
}

.chat-header-info {
    flex-direction: column;
    margin-left: 16px;
}

.chat-header-info .html-tag-h3 {
    font-size: 16px;
    margin-bottom: 2px;
    color: rgb(255,255,255);
    -unity-font-style: bold;
}

.chat-header-info .html-tag-p {
    font-size: 12px;
    color: rgba(255,255,255,0.8);
    margin-bottom: 0;
}

.chat-messages {
    padding: 28px;
    min-height: 400px;
    max-height: 500px;
    flex-grow: 1;
}

.chat-input {
    padding: 20px 28px;
    border-top-width: 1px;
    border-top-color: rgb(224,228,236);
    align-items: center;
    flex-direction: row;
}

/* ====== Результаты ====== */

.results-hero {
    border-radius: 24px;
    padding: 48px;
    color: rgb(255,255,255);
    -unity-text-align: middle-center;
    margin-bottom: 40px;
    background-color: rgb(35,62,118);
    flex-direction: column;
    align-items: center;
}

.results-hero .html-tag-h1 {
    color: rgb(255,255,255);
    margin-bottom: 16px;
}

.results-hero .html-tag-p {
    color: rgba(255,255,255,0.9);
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 32px;
    max-width: 600px;
    white-space: normal;
}

.score-circle {
    width: 180px;
    height: 180px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 24px;
    border-radius: 90px;
    background-color: rgba(255,255,255,0.15);
    border-width: 8px;
    border-color: rgb(1,152,175);
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.score-value {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(255,255,255);
}

.score-label {
    margin-top: 4px;
    color: rgb(255,255,255);
}

.results-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 40px;
}

.result-card {
    background-color: rgb(255,255,255);
    border-width: 1px;
    border-color: rgb(224,228,236);
    border-radius: 16px;
    padding: 28px;
    flex-grow: 1;
    flex-basis: 380px;
    flex-direction: column;
    margin: 12px;
}

.result-card .html-tag-h3 {
    font-size: 18px;
    color: rgb(35,62,118);
    margin-bottom: 16px;
    align-items: center;
    -unity-font-style: bold;
}

.html-tag-ul {
    flex-direction: column;
}

.html-tag-li {
    padding-top: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(240,242,245);
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
}

.score-bar {
    width: 100px;
    height: 6px;
    background-color: rgb(224,228,236);
    border-radius: 3px;
    overflow: hidden;
    flex-direction: row;
}

.score-bar-fill {
    height: 100%;
    background-color: rgb(1,152,175);
    border-radius: 3px;
}

.recommendation-card {
    border-width: 2px;
    border-color: rgb(1,152,175);
    border-radius: 16px;
    padding: 28px;
    margin-top: 24px;
    background-color: rgb(239,246,250);
    flex-direction: column;
}

.recommendation-card .html-tag-h4 {
    font-size: 16px;
    color: rgb(35,62,118);
    margin-bottom: 12px;
    -unity-font-style: bold;
}

.recommendation-card .html-tag-p {
    color: rgb(2,2,2);
    margin-bottom: 16px;
}

.rec-tag {
    background-color: rgb(35,62,118);
    color: rgb(255,255,255);
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 11px;
    margin-right: 8px;
    margin-bottom: 8px;
    -unity-font-style: bold;
}

/* ====== Footer ====== */

.footer {
    background-color: rgb(25,61,87);
    color: rgba(255,255,255,0.8);
    padding-top: 40px;
    padding-bottom: 24px;
    flex-direction: column;
}

.footer-inner {
    max-width: 1360px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 32px;
    padding-right: 32px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.footer .html-tag-h4 {
    color: rgb(255,255,255);
    margin-bottom: 16px;
    -unity-font-style: bold;
}

.footer .html-tag-p,
.footer .html-tag-a {
    font-size: 13px;
    color: rgba(255,255,255,0.7);
    white-space: normal;
}

.footer .html-tag-a:hover {
    color: rgb(1,152,175);
}

.footer-bottom {
    max-width: 1360px;
    margin-top: 32px;
    margin-left: auto;
    margin-right: auto;
    padding-top: 20px;
    padding-left: 32px;
    padding-right: 32px;
    border-top-width: 1px;
    border-top-color: rgba(255,255,255,0.1);
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgba(255,255,255,0.5);
    white-space: normal;
}

/* ====== Мелкие утилиты ====== */

.html-tag-div { flex-direction: column; }
.html-tag-section { flex-direction: column; }
.html-tag-main { flex-direction: column; }
.html-tag-footer { flex-direction: column; }
.html-tag-button { /* у кнопок flex-direction задаётся в .btn */ }